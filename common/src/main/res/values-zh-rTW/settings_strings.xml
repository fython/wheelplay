    <string name="settings_web_description">監聽設定無需 Root。Web 網域名稱同時用於 HTTP 和 HTTPS，需解析到實際存取的 IP；填寫不會自動配置 DNS，自定義 HTTPS 憑證需覆蓋此網域名稱。</string>
    <string name="settings_https">啟用 HTTPS</string>
    <string name="settings_https_description">為瀏覽器提供 HTTPS 存取；瀏覽器麥克風需要可信憑證。</string>
    <string name="settings_certificate_type">憑證型別</string>
    <string name="settings_select_pem">選擇 PEM 憑證與私密金鑰</string>
    <string name="settings_select_pkcs12">選擇 PKCS#12 檔案</string>
    <string name="settings_certificate_custom">目前使用自定義憑證</string>
    <string name="settings_certificate_default">目前使用預設本機憑證</string>
    <string name="settings_certificate_description">憑證和私密金鑰儲存在 App 私有儲存。PEM 依次選擇憑證鏈、私密金鑰；PKCS#12 可選擇私密金鑰條目。</string>
    <string name="settings_connection_mode">連線方案</string>
    <string name="settings_tesla_description">主要用於幫助遮蔽私有網段存取的車機繞過地址限制，存取手機上的本機服務。除 Tesla 外，有同類限制的其他品牌車機也可嘗試。</string>
    <string name="settings_enable_vpn">啟用免 Root Tesla 相容</string>
    <string name="settings_enable_vpn_description">需要 Android VPN 授權，無需 Root 或 Shizuku；可能與其他 VPN 衝突。</string>
    <string name="settings_access_ip">存取 IP 地址</string>
    <string name="settings_vpn_description">請讓車機連線此手機的系統熱點，使用 http://%1$s:%2$d。此方案可能不相容部分手機或車機，系統更新後可能失效。有線 CarPlay 已連線時，啟用或修改 IP 將等待中斷連線後生效。</string>
    <string name="settings_vpn_ports_description">直接使用 Web 監聽埠，無低位埠對映。可選 HTTPS 仍需車機信任憑證；WebRTC 影片需單獨驗證。</string>
    <string name="settings_retry_vpn">授權或重試 VPN</string>
    <string name="settings_request_root">請求 Root 權限</string>
    <string name="settings_enable_root">啟用 Tesla 相容</string>
    <string name="settings_enable_root_description">將 HTTP / HTTPS 低位埠及自定義 IP 共享給熱點裝置。</string>
    <string name="settings_http_mapping">對映 HTTP 埠</string>
    <string name="settings_https_mapping">對映 HTTPS 埠</string>
    <string name="settings_https_disabled">HTTPS 已關閉</string>
    <string name="settings_root_description">對映只作用於此存取 IP，不改變 Web 監聽埠。HTTPS 對映僅在 HTTPS 開啟時生效；請開啟系統熱點，自定義憑證需覆蓋存取 IP 或網域名稱。</string>
    <string name="settings_retry_root">重新啟動 Root 路由</string>
    <string name="settings_importing">正在本機匯入…</string>
    <string name="settings_auth_ready">資源已就緒 · 私密金鑰與憑證校驗透過</string>
    <string name="settings_auth_missing">尚未配置有效資源</string>
    <string name="settings_auth_description">開源安裝包不包含認證資源。可選擇現有的兩份檔案，或下載 DiPlay 官網 APK 後在此匯入，無需安裝 DiPlay。</string>
    <string name="settings_import_apk">從 DiPlay APK 匯入</string>
    <string name="settings_import_files">手動選擇認證資源</string>
    <string name="settings_upstream_download">DiPlay 官網下載</string>
    <string name="settings_upstream_download_description">下載 APK 後返回匯入，或分享給 WheelPlay</string>
    <string name="settings_auth_storage">僅提取認證資源並儲存在此裝置的應用私有目錄，不上傳。匯入結束後刪除臨時 APK；解除安裝 WheelPlay 將刪除已匯入資源。</string>
    <string name="settings_import_files_title">選擇兩份匹配的資源</string>
    <string name="settings_import_files_message">先選擇 identity.pk8（PKCS#8 私密金鑰），再選擇 certificate.p7b（P-256 憑證）。兩份檔案必須來自同一套資源；取消或校驗失敗不會替換原有資源。</string>
    <string name="settings_permissions_help">權限與連線幫助</string>
    <string name="settings_permissions_description">附近裝置權限用於連線 iPhone，麥克風用於 Siri 和通話。舊版 Android 的無線連線還需要定位權限，USB 模式可能請求本機 VPN 授權。</string>
