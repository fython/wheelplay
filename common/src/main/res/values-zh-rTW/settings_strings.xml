    <string name="settings_bluetooth_settings">系統藍芽設定</string>
    <string name="settings_wireless_help">無線連線幫助</string>
    <string name="settings_about_diagnostics">關於與診斷</string>
    <string name="settings_exporting">正在儲存報告…</string>
    <string name="settings_export">儲存診斷報告</string>
    <string name="settings_export_downloads">報告儲存到 Downloads/WheelPlay。不會自動上傳，報告排除協議載荷和憑據。</string>
    <string name="settings_export_document">請選擇報告儲存位置。不會自動上傳，報告排除協議載荷和憑據。</string>
    <string name="settings_licenses">基於 xcertplay / DiPlay，保留 GPL-3.0 與 AGPL-3.0 許可宣告。CarPlay 與 NIO 圖示屬於各自權利人。</string>
    <string name="settings_open_source">開源</string>
    <string name="settings_source">原始碼地址</string>
    <string name="settings_fingerprint_disabled">HTTPS 已關閉，請在 Web 服務中開啟。</string>
    <string name="settings_fingerprint_pending">HTTPS 服務正在準備或啟動失敗，請稍後重試。</string>
    <string name="settings_fingerprint_value">請在車機安裝憑證前，與瀏覽器頁面顯示的 SHA-256 指紋逐字核對：\n\n%1$s</string>
    <string name="settings_browser_description">配對後的瀏覽器會被記住，下次開啟時自動恢復配對；選擇啟動選項後，點選網頁上的「啟動顯示」。</string>
    <string name="settings_devices">連線過的裝置</string>
    <string name="settings_devices_description">檢視、重新命名或移除瀏覽器</string>
    <string name="settings_offline">瀏覽器離線後的處理</string>
    <string name="settings_offline_description">計時從 CarPlay 會話啟動且無瀏覽器連線時開始；瀏覽器重連會取消計時。超時只中斷連線 iPhone，Web 服務保持執行。</string>
    <string name="settings_browser_devices">連線過的瀏覽器</string>
    <string name="settings_devices_empty">還沒有記住的瀏覽器。首次在網頁掃碼或輸入配對碼後會自動儲存。</string>
    <string name="settings_remove_all">移除全部裝置</string>
    <string name="settings_browser_name">瀏覽器名稱</string>
