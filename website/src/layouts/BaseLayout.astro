---
import "../styles/global.css";
import { localeFromPath, localizePath } from "../i18n";

const locale = localeFromPath(Astro.url.pathname);

interface Props {
  title?: string;
  description?: string;
  socialDescription?: string;
  noIndex?: boolean;
  bodyClass?: string;
}
const {
  title = locale === "en" ? "WheelPlay · CarPlay in your browser" : "WheelPlay · 让 CarPlay，在浏览器里就位",
  description = locale === "en" ? "WheelPlay is an open-source Android CarPlay server for local networks. Bring iPhone CarPlay to your car browser with touch control, USB, and wireless connections." : "WheelPlay 是开源的 Android 局域网 CarPlay 服务端。将 iPhone 的 CarPlay 带到车机浏览器，支持触控、USB 与无线连接，无需在车机安装客户端。",
  socialDescription = description,
  noIndex = false,
  bodyClass,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f8fafc" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "zh_CN"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    {noIndex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" href="/assets/app-icon.svg" type="image/svg+xml" />
    {!noIndex && <>
      <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
      <link rel="alternate" hreflang="zh-CN" href={new URL(localizePath(Astro.url.pathname, "zh-CN"), Astro.site)} />
      <link rel="alternate" hreflang="en" href={new URL(localizePath(Astro.url.pathname, "en"), Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(localizePath(Astro.url.pathname, "zh-CN"), Astro.site)} />
    </>}
    <script>
      import "../scripts/language";
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
