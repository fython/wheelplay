---
import { useTranslations } from "../i18n";
const { t } = useTranslations(Astro.url.pathname);
---

<section class="closing container">
  <div>
    <p class="eyebrow">OPEN SOURCE. OPEN POSSIBILITIES.</p>
    <h2>{t("下一程，一起把体验变得更好。")}</h2>
    <p>{t("从一次使用、一条反馈，到一份代码贡献。")}</p>
  </div>
  <a class="button secondary" href="https://github.com/fython/wheelplay"
    >{t("在 GitHub 探索 WheelPlay")}<span aria-hidden="true">↗</span></a
  >
</section>
