---
import { useTranslations } from "../i18n";
const { t, local } = useTranslations(Astro.url.pathname);
import Brand from "./Brand.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
---

<header class="site-header">
  <div class="header-inner">
    <Brand href={local("/")} size={32} label />
    <nav aria-label={t("主导航")}>
      <a href={local("/#features")}>{t("功能")}</a><a href={local("/docs/")}>{t("使用文档")}</a
      ><a href={local("/docs/faq/")}>{t("常见问题")}</a>
    </nav>
    <div class="header-actions">
      <LanguageSwitch />
      <button
        class="icon-button theme-toggle"
        type="button"
        aria-label={t("切换到深色主题")}
        aria-pressed="false"
        hidden
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path d="M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z" />
        </svg>
      </button>
      <a class="github-link" href="https://github.com/fython/wheelplay"
        ><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.69c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.6 9.6 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.7-4.58 4.95.36.31.68.92.68 1.85v2.58c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
          /></svg
        ><span>GitHub</span><span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
</header>

<script>
  import "../scripts/theme";
</script>
