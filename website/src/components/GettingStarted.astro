---
import { useTranslations } from "../i18n";
const { t, local, locale } = useTranslations(Astro.url.pathname);
---

<section
  class="start-section section"
  id="start"
  aria-labelledby="start-title"
>
  <div class="container start-layout">
    <div class="start-intro">
      <p class="eyebrow">READY WHEN YOU ARE.</p>
      <h2 id="start-title">{t("从这里，")}<br />{t("开始连接。")}</h2>
      <p>{t("准备一台 Android 9+ 设备，")}<br />{t("以及能够通过局域网访问它的车机浏览器。")}</p>
      <a
        class="button primary"
        href={locale === "en" ? "/download?lang=en" : "/download"}
        >{t("下载最新开发构建")}<span aria-hidden="true">↗</span></a
      >
      <p class="download-note">{t("自动前往 main 分支最新成功构建的")}<br /><code>wheelplay-debug-apk</code>{t("产物页面，结果最多缓存 5 分钟。")}<br />{t("下载需要登录 GitHub，且产物可能过期。")}</p>
      <a
        class="text-link"
        href={locale === "en" ? "https://github.com/fython/wheelplay/blob/main/README.md#build" : "https://github.com/fython/wheelplay/blob/main/README.zh-CN.md#构建"}
        >{t("也可以从源码构建")}<span aria-hidden="true">↗</span></a
      >
    </div>
    <ol class="setup-steps">
      <li>
        <span class="setup-number">01</span>
        <div>
          <h3>{t("在 Android 上，准备好 WheelPlay")}</h3>
          <p>{t("安装并打开应用，在「输入源」中选择连接方式。仅 CarPlay 需要导入认证资源；Android Auto、VNC 和诊断源无需这些资源。")}</p>
          <a
            class="text-link"
            href="https://github.com/fython/wheelplay/blob/main/docs/AUTHENTICATION_IMPORT.md"
            >{t("查看认证资源导入说明")}<span aria-hidden="true">↗</span></a
          >
        </div>
      </li>
      <li>
        <span class="setup-number">02</span>
        <div>
          <h3>{t("同一网络，打开同一个入口")}</h3>
          <p>{t("让 Android 与车机接入同一局域网，在车机浏览器中打开 WheelPlay 应用显示的访问地址。")}</p>
          <span class="step-hint"
            >{t("使用 App 中的实际地址，无需访问本官网连接。")}</span
          >
        </div>
      </li>
      <li>
        <span class="setup-number">03</span>
        <div>
          <h3>{t("配对浏览器，连接你的输入源")}</h3>
          <p>{t("扫描网页二维码或输入配对码，启动显示。按输入源的指引连接 iPhone、Android Auto 手机或已有的 VNC 服务端；切换输入源后可能需要重新连接浏览器。")}</p>
          <a
            class="text-link"
            href={local("/docs/")}
            >{t("阅读完整使用步骤")}<span aria-hidden="true">→</span></a
          >
        </div>
      </li>
    </ol>
  </div>
</section>
