                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                >
                  <path
                    d="m5 3 4 4-2 3c1 3 4 6 7 7l3-2 4 4-2 2C10 22 2 14 3 5Z"
                  /></svg></span
              ><span class="dock-home">▦</span>
            </div>
            <div class="map-surface">
              <svg
                class="map-art"
                viewBox="0 0 640 360"
                preserveAspectRatio="xMidYMid slice"
                aria-hidden="true"
              >
                <rect width="640" height="360" fill="#e9ede7" />
                <path
                  d="M440-20c-95 95 80 164 18 246s-9 125 45 154h167V-20Z"
                  fill="#b6d8de"
                />
                <path
