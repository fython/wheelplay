<section
  class="demo-section container"
  aria-label="WheelPlay 工作方式交互示意"
>
  <div class="workspace">
    <div class="workspace-bar">
      <div class="window-dots" aria-hidden="true">
        <i></i><i></i><i></i>
      </div>
      <span class="workspace-title"
        >WheelPlay <span>/</span> 浏览器里的驾驶搭档</span
      ><span class="demo-badge">交互示意</span>
    </div>
    <div class="workspace-body">
      <aside class="source-panel" aria-label="设备连接说明">
        <div class="panel-heading">
          <span class="small-icon"
            ><svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <path d="M5 4v10h14m-5-5 5 5-5 5" /></svg></span
          ><span>连接你的世界</span><span class="mono">01 — 03</span>
        </div>
        <div class="device-flow">
          <div class="device-step">
            <span class="device-icon"
              ><svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="6" y="2" width="12" height="20" rx="3" />
                <path d="M10 5h4m-3 14h2" /></svg
            ></span>
            <div>
              <strong>iPhone</strong>
              <p>你的 CarPlay，原样带来</p>
            </div>
            <span class="step-number">01</span>
          </div>
          <div class="flow-line"><span>USB 或无线连接</span></div>
          <div class="device-step active">
            <img
              class="device-icon app-icon"
              src="/assets/app-icon.svg"
              width="40"
              height="40"
              alt=""
            />
            <div>
              <strong>Android + WheelPlay</strong>
              <p>小小的连接中枢</p>
            </div>
            <span class="step-number">02</span>
          </div>
          <div class="flow-line"><span>同一局域网</span></div>
          <div class="device-step">
            <span class="device-icon"
              ><svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="2" y="4" width="20" height="14" rx="2" />
                <path d="M8 22h8m-4-4v4" /></svg
            ></span>
            <div>
              <strong>车机浏览器</strong>
              <p>打开网页，即可显示与触控</p>
            </div>
            <span class="step-number">03</span>
          </div>
        </div>
        <div class="local-note">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z" />
            <path d="m8 12 3 3 5-6" />
          </svg>
          <div>
            <strong>连接留在局域网</strong>
            <p>串流无需额外部署云端服务器。</p>
          </div>
        </div>
      </aside>
      <div class="preview-panel">
        <div class="preview-toolbar">
          <div
            class="preview-tabs"
            role="tablist"
            aria-label="切换体验示意"
          >
            <button
              id="tab-navigation"
              type="button"
              role="tab"
              aria-selected="true"
              aria-controls="panel-navigation"
              data-view="navigation"
            >
              导航视图</button
            ><button
              id="tab-music"
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="panel-music"
              tabindex="-1"
              data-view="music"
            >
              音乐视图</button
            ><button
              id="tab-connection"
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="panel-connection"
              tabindex="-1"
              data-view="connection"
            >
              连接流程
            </button>
          </div>
          <span class="preview-label"
            ><span class="status-dot"></span>体验预览</span
          >
        </div>
        <div class="display-shell">
          <div
            class="car-display"
            id="panel-navigation"
            role="tabpanel"
            aria-labelledby="tab-navigation"
            tabindex="0"
          >
            <div class="car-sidebar" aria-hidden="true">
              <span class="car-time">09:41</span
              ><span class="signal">▂▄▆</span
              ><span class="dock-icon map-icon">↗</span
              ><span class="dock-icon music-icon">♫</span
              ><span class="dock-icon phone-icon"
