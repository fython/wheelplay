                  fill="#d7dfd2"
                />
                <g fill="none" stroke="#fff" stroke-width="16">
                  <path
                    d="m-20 136 660-37M167-20l44 400M-10 331l650-49M388-20l41 400"
                  />
                  <path d="m0 21 640 180" stroke-width="10" />
                </g>
                <g fill="none" stroke="#c7cfca" stroke-width="1">
                  <path
                    d="m-20 136 660-37M167-20l44 400M-10 331l650-49M388-20l41 400"
                  />
                </g>
                <path
                  d="m284 360-8-74-73 5-20-166 178-10"
                  fill="none"
                  stroke="#fff"
                  stroke-width="16"
                  stroke-linejoin="round"
                />
                <path
                  d="m284 360-8-74-73 5-20-166 178-10"
                  fill="none"
                  stroke="#5087f2"
                  stroke-width="9"
                  stroke-linejoin="round"
                />
                <circle
                  cx="361"
                  cy="115"
                  r="9"
                  fill="#5087f2"
                  stroke="#fff"
                  stroke-width="4"
                />
                <g fill="#8b988e" font-size="11" font-family="sans-serif">
                  <text x="248" y="194">城市公园</text>
                  <text x="480" y="259">滨江绿道</text>
                  <text x="62" y="246" transform="rotate(-5 62 246)">
                    梧桐路
                  </text>
                </g>
                <g transform="translate(202 245)">
                  <circle r="24" fill="#5087f2" opacity=".15" />
                  <circle r="16" fill="white" />
                  <path d="m0-12 10 21-10-4-10 4Z" fill="#3273e8" />
                </g>
              </svg>
              <div class="turn-card">
                <span
                  ><svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path
                      d="M6 21V10a3 3 0 0 1 3-3h11m-6-6 6 6-6 6"
                    /></svg
                ></span>
                <div>
                  <strong>前方 300 米</strong
                  ><span>右转，驶入新的旅程</span>
                </div>
              </div>
              <div class="arrival-card">
                <strong>12 <small>分钟</small></strong
                ><span>6.8 公里 · 一路向前</span
                ><span class="route-symbol" aria-hidden="true">↗</span>
              </div>
            </div>
            <div class="dashboard-widgets">
              <div class="mini-music">
                <div class="album-art" aria-hidden="true">
                  <span></span>
                </div>
                <strong>On the road</strong><span>你的随行歌单</span>
                <div class="music-controls" aria-hidden="true">
                  ‹ <span>Ⅱ</span> ›
                </div>
              </div>
              <div class="destination-widget">
                <span class="home-symbol" aria-hidden="true">⌂</span>
                <div>
                  <strong>下一站，回家</strong
                  ><span>熟悉的路，熟悉的体验</span>
                </div>
              </div>
            </div>
          </div>
          <div
            class="car-display music-display"
            id="panel-music"
            role="tabpanel"
            aria-labelledby="tab-music"
            tabindex="0"
            hidden
          >
            <div class="music-art-large album-art" aria-hidden="true">
              <span></span>
              <div>THE<br />OPEN<br />ROAD.</div>
            </div>
            <div class="music-copy">
              <span class="eyebrow">YOUR EVERYDAY SOUNDTRACK</span>
              <h3>让喜欢的音乐，<br />陪你多走一程。</h3>
              <p>
                在 CarPlay 中使用你的音乐 App。<br />默认由 Android
                输出音频，也可切换到浏览器。
              </p>
              <div class="illustrated-track">
                <span>On the road</span><span>示意歌单 · 不播放音频</span>
              </div>
              <div class="track-progress" aria-hidden="true">
                <span></span>
              </div>
              <div class="music-controls" aria-hidden="true">
                ‹ <span>Ⅱ</span> ›
              </div>
            </div>
          </div>
          <div
            class="car-display connection-display"
            id="panel-connection"
            role="tabpanel"
            aria-labelledby="tab-connection"
            tabindex="0"
            hidden
          >
            <span class="connection-symbol"
              ><svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <path
                  d="M3 8a14 14 0 0 1 18 0M6 12a9 9 0 0 1 12 0M9 16a4 4 0 0 1 6 0"
                />
                <circle cx="12" cy="20" r=".8" /></svg
            ></span>
            <h3>第一次配对，<br />下一次更从容。</h3>
            <p>
              用 WheelPlay 扫描车机网页二维码，<br />或在车机输入配对码。确认后，启动显示。
            </p>
            <div
              class="pair-code"
              aria-label="示例配对码，不可用于实际连接"
            >
              <span>1</span><span>2</span><span>3</span><span>4</span
              ><span>5</span><span>6</span>
            </div>
            <span class="connection-footnote"
              >示例配对码 · 已记住的浏览器可恢复配对</span
            >
          </div>
        </div>
        <div class="preview-status">
          <span><span class="status-dot"></span>浏览器显示与触控</span
          ><span class="mono" id="preview-mode"
            >NAVIGATION / PREVIEW</span
          >
        </div>
      </div>
    </div>
  </div>
  <p class="demo-caption">
    <span
      ><svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        aria-hidden="true"
      >
        <path d="M5 4v10h14m-5-5 5 5-5 5" /></svg
    ></span>
    上方为交互示意，并非真实 CarPlay 截图或在线连接入口；实际界面由 iPhone
    与所用 App 决定。
  </p>
</section>

