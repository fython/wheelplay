---
import { useTranslations } from "../i18n";
const { t, local } = useTranslations(Astro.url.pathname);
---

<section class="hero container" aria-labelledby="hero-title">
  <h1 id="hero-title">{t("让 CarPlay，")}<br /><span>{t("在浏览器里就位。")}</span></h1>
  <p class="hero-description">{t("一部 Android，一块车机屏幕。")}<br />{t("把 iPhone 的熟悉体验，带到你的每一次出发。")}</p>
  <div class="hero-actions">
    <a class="button primary" href="#start"
      ><svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path d="m9 5 7 7-7 7" /></svg
      >{t("开始使用 WheelPlay")}</a
    ><a
      class="button secondary"
      href={local("/docs/")}
      >{t("阅读使用文档")}<span aria-hidden="true">→</span></a
    >
  </div>
  <div class="hero-notes">
    <span
      ><svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="m3 8 3 3 7-7" /></svg
      >Android 9+</span
    ><span
      ><svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="m3 8 3 3 7-7" /></svg
      >{t("车机无需安装 App")}</span
    ><span
      ><svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="m3 8 3 3 7-7" /></svg
      >{t("局域网直连")}</span
    >
  </div>
</section>
