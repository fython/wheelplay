{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "wheelplay-website",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-23",
  // Required by `wrangler preview`; static assets remain configured at the top level.
  "previews": {},
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "issues": {
      "enabled": false,
    },
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/download", "/download/*"],
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
